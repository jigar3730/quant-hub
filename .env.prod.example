# Quant Hub — PROD template. Copy to .env.prod (never commit .env.prod).
APP_ENV=prod
LOG_LEVEL=WARNING

POSTGRES_USER=quant
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_PASSWORD
POSTGRES_DB=quant_hub
POSTGRES_PORT=5433

DATABASE_URL=postgresql://quant:REPLACE_WITH_STRONG_PRODUCTION_PASSWORD@postgres:5432/quant_hub

DASHBOARD_PORT=5002
API_PORT=5010

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=prod-smtp-user
SMTP_PASSWORD=REPLACE_WITH_PROD_SMTP_PASSWORD
SMTP_USE_TLS=true
EMAIL_FROM=quant-hub@example.com
EMAIL_TO=you@example.com

TZ=America/New_York
