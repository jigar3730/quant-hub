# Quant Hub — DEV template. Copy to .env.dev (never commit .env.dev).
APP_ENV=dev
LOG_LEVEL=DEBUG

POSTGRES_USER=quant
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=quant_hub_dev
POSTGRES_PORT=5433

# Compose builds this for the app container. Host CLIs use localhost:5433.
DATABASE_URL=postgresql://quant:dev-only-change-me@postgres:5432/quant_hub_dev

DASHBOARD_PORT=5002

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_TO=dev@localhost

TZ=America/New_York
