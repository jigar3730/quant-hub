# Quant Hub — STAGE template. Copy to .env.stage (never commit .env.stage).
APP_ENV=stage
LOG_LEVEL=INFO

POSTGRES_USER=quant
POSTGRES_PASSWORD=REPLACE_WITH_STAGE_PASSWORD
POSTGRES_DB=quant_hub_stage
POSTGRES_PORT=5434

DATABASE_URL=postgresql://quant:REPLACE_WITH_STAGE_PASSWORD@postgres:5432/quant_hub_stage

DASHBOARD_PORT=5003
API_PORT=5011

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=stage-smtp-user
SMTP_PASSWORD=REPLACE_WITH_STAGE_SMTP_PASSWORD
SMTP_USE_TLS=true
EMAIL_FROM=quant-hub-stage@example.com
EMAIL_TO=stage-oncall@example.com

TZ=America/New_York
