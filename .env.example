#   .env.dev.example   →  .env.dev    ./scripts/run_env.sh dev up --build -d
#   .env.stage.example →  .env.stage  ./scripts/run_env.sh stage up -d
#   .env.prod.example  →  .env.prod   ./scripts/run_env.sh prod up -d
