# Required — no weak defaults. Generate a strong password.
POSTGRES_PASSWORD=change-me
# Host-side URL for tools on the machine (dev stack maps 5434 → 5432 in the container).
# Inside Docker, compose sets DATABASE_URL to the postgres service automatically.
DATABASE_URL=postgresql://quant:change-me@localhost:5434/quant_hub

# Email notifications (quant-daily breakout + quant-swing weekly)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
EMAIL_TO=you@example.com
